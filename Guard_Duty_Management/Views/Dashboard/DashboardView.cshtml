    <script>

            function updateHeaderDateTime() {
                const now = new Date();

                const formatted = now.toLocaleString('en-US', {
                    weekday: 'short',
                    month: 'short',
                    day: '2-digit',
                    year: 'numeric',
                    hour: 'numeric',
                    minute: '2-digit',
                    hour12: true
                });

                document.getElementById('headerDateTime').textContent = formatted;
            }

            updateHeaderDateTime();
            setInterval(updateHeaderDateTime, 60000);

            // Default date picker to today's local date
            const dateInput = document.getElementById('headerDate');
            const today = new Date();
            const localDate = [
                today.getFullYear(),
                String(today.getMonth() + 1).padStart(2, '0'),
                String(today.getDate()).padStart(2, '0')
            ].join('-');

            dateInput.value = localDate;

            // Clock-In switch display
            const clockInSwitch = document.getElementById('clockInSwitch');
            const clockInStatus = document.getElementById('clockInStatus');

            clockInSwitch.addEventListener('change', function () {
                clockInStatus.textContent = this.checked ? 'ON' : 'OFF';
            });



            // showClockInForm = false;
    </script>


