            <div class="col-lg-6 col-12 d-flex align-items-center justify-content-center">
                    <div class="card w-100 h-100 d-flex align-items-center justify-content-center">
                    <div class="card-body">
                        <div class="p-2 d-flex flex-column align-items-center justify-content-center">

                            <div class="empty-illustration">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="180" height="160" viewBox="0 0 180 160"
                                     fill="none" aria-hidden="true">

                                    <!-- Soft background -->
                                    <circle cx="85" cy="85" r="62" fill="#F7F2E8" />
