                                    <div class="p-3 bg-danger-subtle rounded-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#D93643" class="bi bi-clock" viewBox="0 0 16 16">
                                            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71z" />
