<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="~/lib/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css_/dashboardview.css" rel="stylesheet"/>
    <link href="~/css_/header.css" rel="stylesheet"/>
</head>

<body>

    @Html.AntiForgeryToken()

    <div class="container-fluid bg-main p-0" id="DashboardView" v-cloak>
        <app-header></app-header>

        <!-- NAVIGATION / ACTION BAR -->
        <nav class="navbar navbar-expand-lg px-3 py-2"
             style="background-color: #F5F7FA;">

            <div class="container-fluid p-0">

                <div class="row-cols-2">

                    <!-- Left Actions -->
                    <div class="col">
                        <div class="d-flex flex-wrap align-items-center gap-3">

                            <a href="/Dashboard/DashboardView"
                               class="btn disable-btn fw-semibold px-3 py-2">

                                <div class="d-flex align-items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="bi bi-clipboard-minus" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M5.5 9.5A.5.5 0 0 1 6 9h4a.5.5 0 0 1 0 1H6a.5.5 0 0 1-.5-.5" />
                                        <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                                        <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z" />
                                    </svg>
                                    Task
                                </div>
                            </a>

                            <a href="/Dashboard/IncidentView"
                               class="btn btn-light fw-semibold px-3 py-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle" viewBox="0 0 16 16">
                                    <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057m1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z" />
                                    <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z" />
                                </svg>
                                Incident
                            </a>

                            <button type="button"
                                    class="btn security-bg fw-semibold px-3 py-2"
                                    id="addTaskButton" v-on:click="showAddTaskForm = true">
                                Add Task
                            </button>

                        </div>
                    </div>
                    

                    <!-- Right Controls -->
                    <div class="col">                    
                        <div class="d-flex flex-wrap align-items-center gap-3 ms-lg-auto mt-3 mt-lg-0">

                            <!-- Date Picker -->
                            <div class="input-group bg-white shadow-sm rounded"
                                 style="width: 210px;">

                                <input type="date"
                                       class="form-control border-0 rounded"                                   
                                       v-model="selectedDate"
                                       aria-label="Select date" />

                            </div>

                            <!-- Clock-In Toggle -->
                            <div class="d-flex align-items-center gap-2 bg-white rounded px-3 py-2 shadow-sm"
                                 style="min-width: 265px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-arrow-repeat" viewBox="0 0 16 16">
                                    <path d="M11.534 7h3.932a.25.25 0 0 1 .192.41l-1.966 2.36a.25.25 0 0 1-.384 0l-1.966-2.36a.25.25 0 0 1 .192-.41m-11 2h3.932a.25.25 0 0 0 .192-.41L2.692 6.23a.25.25 0 0 0-.384 0L.342 8.59A.25.25 0 0 0 .534 9" />
                                    <path fill-rule="evenodd" d="M8 3c-1.552 0-2.94.707-3.857 1.818a.5.5 0 1 1-.771-.636A6.002 6.002 0 0 1 13.917 7H12.9A5 5 0 0 0 8 3M3.1 9a5.002 5.002 0 0 0 8.757 2.182.5.5 0 1 1 .771.636A6.002 6.002 0 0 1 2.083 9z" />
                                </svg>

                                <span class="fw-semibold text-secondary text-nowrap">
                                    ClockIn:
                                </span>

                                <span id="clockInStatus"
                                      class="fw-semibold text-nowrap">
                                    OFF
                                </span>

                                <div class="form-check form-switch mb-0 ms-auto">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           role="switch"
                                           id="clockInSwitch"
                                           aria-label="Toggle Clock-In"
                                           style="cursor: pointer;">
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </nav>

    


        <div v-if="showClockInForm" class="container-fluid d-flex align-items-center popup-form bg-custom-blur position-fixed start-0 top-0 py-3 mb-2">
            <div class="row justify-content-center align-items-center w-100 h-100">
                <div class="col-md-4 col-12">
                    <div class="mt-5 text-dark card bg-grad rounded-3 shadow-lg px-3">
                        <div class="card-body border-0">
                            <button class="btn-close btn-icon btn-close-dark position-absolute top-0 end-0 m-3" v-on:click="showAddForm = false"></button>

                            <div class="row gap-3">
                                <div class="col-12">
                                    <div class="mb-2">
                                        <span class="fs-4 fw-bold">Clock In</span>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Site</label>
                                        <select class="form-select">
                                            <option value="0">Select Site</option>
                                            @* @foreach (var service in activeServices)
                                            {
                                                <option value="@service.ServiceId">
                                                    @service.ServiceName
                                                </option>
                                            } *@
                                        </select>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">Shift</label>
                                        <select class="form-select">
                                            <option value="0">Select Shift</option>
                                            @* @foreach (var service in activeServices)
                                            {
                                                <option value="@service.ServiceId">
                                                    @service.ServiceName
                                                </option>
                                            } *@

                                        </select>
                                    </div>

                                    <div class="mb-2">
                                        <label class="form-label">Guard Post</label>
                                        <select class="form-select">
                                            <option value="0">Select Guard Post</option>
                                            @* @foreach (var service in activeServices)
                                            {
                                                <option value="@service.ServiceId">
                                                    @service.ServiceName
                                                </option>
                                            } *@

                                        </select>
                                    </div>

                                    <div class="my-3 d-flex justify-content-end gap-3">
                                        @* <button type="button" @onclick ="ClockIn" class="btn btn-secondary">Clock In</button>
                                        <button type="button" @onclick ="()=>showClockInForm=false" class="btn btn-danger">Close</button> *@
                                        <button type="button" class="btn btn-secondary">Clock In</button>
                                        <button type="button" class="btn btn-danger" v-on:click="showClockInForm = false">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div v-if="showAddTaskForm" class="container-fluid d-flex align-items-center popup-form bg-custom-blur position-fixed start-0 top-0 py-3 mb-2">
            <div class="row justify-content-center align-items-center w-100 h-100">
                <div class="col-md-4 col-12">
                    <div class="mt-5 text-dark card bg-grad rounded-3 shadow-lg px-3">
