@{
    ViewData["Title"] = "Incident Details";
}

<html>
<head>
    
    <link href="~/css/jquery.magnify.css" rel="stylesheet" />
    
    <link href="~/lib/bootstrap/bootstrap-5.3.8-dist/css/bootstrap.min.css" rel="stylesheet " />
    <link rel="stylesheet" href="~/css_/header.css" />
   @* Azure Maps *@
  <link rel="stylesheet"
      href="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.css">

   <script src="https://atlas.microsoft.com/sdk/javascript/mapcontrol/3/atlas.min.js"></script>
    
    <style>
        /* GENERAL PAGE DESIGN */

        [v-cloak] {
            display: none;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
            background-color: #e9edf1;
            color: #333333;
            font-family: Arial, sans-serif;
        }

        /* PAGE BACKGROUND */

        .incident-page {
            width: 100%;
            min-height: 100vh;
            background-color: #e9edf1;
            padding: 25px 0;
            box-sizing: border-box;
        }

        /* PDF BUTTON */

        .pdf-button-container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto 20px;
            display: flex;
            justify-content: flex-end;
        }

        .pdf-button-container button {
            font-size: 16px;
            font-weight: 600;
            padding: 10px 18px;
        }

        /* INCIDENT REPORT CARD */

        .incident-details-page {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 25px;
            box-sizing: border-box;
            background-color: #ffffff;
            border-radius: 5px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
        }

        /* REPORT HEADING */

        .report-heading {
            text-align: center;
            border-bottom: 1px solid #eeeeee;
            margin-bottom: 15px;
            padding-bottom: 8px;
        }

        .report-heading h3 {
            margin: 0 0 5px;
            font-size: 18px;
            font-weight: 600;
            text-decoration: underline;
        }

        .report-heading p {
            margin: 3px 0;
            font-size: 13px;
        }

        /* MAP */

        .incident-map {
            width: 100%;
            height: 280px;
            margin-bottom: 15px;
        }

        .incident-map iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* SECTION HEADING */

        .section-heading {
            margin: 15px 0 10px;
            font-size: 15px;
            font-weight: 600;
        }

        /* INCIDENT DETAILS GRID */

        .incident-grid {
            display: grid;
            grid-template-columns: 15% 35% 15% 35%;
            width: 100%;
            border-top: 1px solid #e5e7eb;
            border-left: 1px solid #e5e7eb;
        }

        .grid-label,
        .grid-value {
            min-width: 0;
            padding: 10px;
            box-sizing: border-box;
            border-right: 1px solid #e5e7eb;
            border-bottom: 1px solid #e5e7eb;
            font-size: 13px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .grid-label {
            display: flex;
            align-items: center;
            background-color: #f5f5f5;
            font-weight: 600;
        }

        .grid-value {
            background-color: #ffffff;
            font-weight: 400;
        }

        /* FULL-WIDTH ROWS */

        .grid-label.full-label {
            grid-column: 1;
        }

        .grid-value.full-value {
            grid-column: 2 / 5;
            display: block;
            min-width: 0;
            width: 100%;
        }

        .full-value {
            white-space: normal;
            overflow-wrap: anywhere;
        }

        /* ATTENDANCE CHECKBOXES */

        .checkbox-list {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .checkbox-list label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            font-weight: 400;
        }

        .checkbox-list input {
            margin: 0;
        }

        /* INCIDENT IMAGES */

        .incident-images {
            display: flex;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 10px;
            width: 100%;
        }

        .incident-images img {
            display: block;
            width: 90px;
            height: 90px;
            object-fit: cover;
            border: 1px solid #e5e7eb;
            border-radius: 5px;
        }

        /* WHO / WHAT / WHEN / WHERE / WHY */

        .incident-summary {
            width: 100%;
            margin-top: 30px;
            padding: 15px 20px;
            box-sizing: border-box;
            border-top: 1px solid #555555;
        }

        .summary-item {
            margin-bottom: 15px;
        }

        .summary-item strong {
            display: block;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .summary-item p {
            margin: 0;
            font-size: 14px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        /* RESPONSIVE DESIGN */

        @@media screen and (max-width: 768px) {

            .incident-details-page {
                width: 100%;
                margin: 0;
                padding: 12px;
                border-radius: 0;
            }

            .incident-map {
                height: 220px;
            }

            .incident-grid {
                grid-template-columns: 25% 25% 25% 25%;
            }

            .grid-label,
            .grid-value {
                padding: 8px;
                font-size: 12px;
            }

            .incident-images img {
                width: 75px;
                height: 75px;
            }

            .incident-summary {
                padding: 12px;
            }
                
               
        }
        /* Hide static map during normal page viewing */
.pdf-map-image {
    display: none;
}

/* PDF export mode */
#incidentPdfContent.pdf-export-mode #azureIncidentMap {
    display: none;
}

#incidentPdfContent.pdf-export-mode .pdf-map-image {
    display: block;
    width: 100%;
    height: 350px;
    object-fit: cover;
}
/* Hide static map during normal page viewing */
.pdf-map-image {
    display: none;
}

/* PDF export mode */
#incidentPdfContent.pdf-export-mode #azureIncidentMap {
    display: none;
}

#incidentPdfContent.pdf-export-mode .pdf-map-image {
    display: block;
    width: 100%;
    height: 350px;
    object-fit: cover;
}
    </style>
</head>

<body>

    <!-- MAIN VUE APPLICATION -->
    <div id="IncidentDetailsApp" v-cloak>

        <!-- APPLICATION HEADER -->
        <app-header></app-header>

        <!-- INCIDENT PAGE BACKGROUND -->
        <div class="incident-page">
           

            <!-- PDF BUTTON -->
            <div class="pdf-button-container">

                <button type="button"
                        class="btn btn-secondary"
                        @@click="downloadPdf"
                        :disabled="isGeneratingPdf">

                    {{ isGeneratingPdf ? 'Generating PDF...' : 'Generate PDF' }}

                </button>

            </div>

            <!-- INCIDENT REPORT CARD -->
            <!-- Only this section will be exported to PDF -->

            <div id="incidentPdfContent"
                 class="incident-details-page">

                <!-- REPORT HEADING -->

                <div class="report-heading">

                    <h3>{{ incident.reportTitle }}</h3>

                    <p>{{ incident.reportReference }}</p>

                    <p>{{ incident.reportDate }}</p>

                </div>

                <!-- MAP SECTION -->

                @* <div class="incident-map">

                    <iframe title="Incident Location Map"
                            :src="mapUrl"
                            loading="lazy">
                    </iframe>

                </div> *@
                  @* Incident Map using Azure *@
                 <div id="azureIncidentMap" style="height: 350px; width: 100%;"> </div>
                <img v-if="incident.mapImageBase64"
     class="pdf-map-image"
     :src="incident.mapImageBase64"
     alt="Incident Location Map"
     style="width: 100%; height: 350px; object-fit: cover;" />
                <h4 class="section-heading">Incident Details</h4>

              
               

                <!-- INCIDENT DETAILS GRID -->

                <div class="incident-grid">

                    <!-- ID AND STATUS -->

                    <div class="grid-label">Id</div>
                    <div class="grid-value">{{ incident.id }}</div>

                    <div class="grid-label">Status</div>
                    <div class="grid-value">{{ incident.status }}</div>

                    <!-- CLIENT AND REGION -->

                    <div class="grid-label">Client</div>
                    <div class="grid-value">{{ incident.client }}</div>

                    <div class="grid-label">Region</div>
                    <div class="grid-value">{{ incident.region }}</div>

                    <!-- BRANCH AND RAISED BY -->

                    <div class="grid-label">Branch</div>
                    <div class="grid-value">{{ incident.branch }}</div>

                    <div class="grid-label">Raised By</div>
                    <div class="grid-value">{{ incident.raisedBy }}</div>

                    <!-- EMPLOYEE AND DATE -->

                    <div class="grid-label">Employee No</div>
                    <div class="grid-value">{{ incident.employeeNo }}</div>

                    <div class="grid-label">Date and Time</div>
                    <div class="grid-value">{{ incident.dateTime }}</div>

                    <!-- GPS AND SITE -->

                    <div class="grid-label">Open GPS Location</div>
                    <div class="grid-value">{{ incident.openGpsLocation }}</div>

                    <div class="grid-label">Site Name</div>
                    <div class="grid-value">{{ incident.siteName }}</div>

                    <!-- LOCATION AND TYPE -->

                    <div class="grid-label">Location Name</div>
                    <div class="grid-value">{{ incident.locationName }}</div>

                    <div class="grid-label">Type</div>
                    <div class="grid-value">{{ incident.type }}</div>

                    <!-- CATEGORY AND SUBCATEGORY -->

                    <div class="grid-label">Category</div>
                    <div class="grid-value">{{ incident.category }}</div>

                    <div class="grid-label">Subcategory</div>
                    <div class="grid-value">{{ incident.subcategory }}</div>

                    <!-- CONDUCTED ON AND ASSIGNED TO -->

                    <div class="grid-label">Conducted On</div>
                    <div class="grid-value">{{ incident.conductedOn }}</div>

                    <div class="grid-label">Assigned To</div>
                    <div class="grid-value">{{ incident.assignedTo }}</div>

                    <!-- ATTENDANCE -->

                    <div class="grid-label">
                        Did the following attend the site?
                    </div>

                    <div class="grid-value">

                        <div class="checkbox-list">

                            <label v-for="attendee in incident.attendees"
                                   :key="attendee.name">

                                <input type="checkbox"
                                       :checked="attendee.checked"
                                       disabled />

                                {{ attendee.name }}

                            </label>

                        </div>

                    </div>

                    <!-- ROLE AND GUARD POST -->

                    <div class="grid-label">Role</div>
                    <div class="grid-value">{{ incident.role }}</div>

                    <div class="grid-label">Guard Post</div>
                    <div class="grid-value">{{ incident.guardPost }}</div>

                    <!-- MANAGERS AND OPS POST -->

                    <div class="grid-label">Assigned Managers</div>
                    <div class="grid-value">{{ incident.assignedManagers }}</div>

                    <div class="grid-label">OPS Post</div>
                    <div class="grid-value">{{ incident.opsPost }}</div>

                    <!-- EMAILS AND CLOSED GPS -->

                    <div class="grid-label">Emails</div>
                    <div class="grid-value">{{ incident.emails }}</div>

                    <div class="grid-label">Closed GPS Location</div>
                    <div class="grid-value">{{ incident.closedGpsLocation }}</div>

                    <!-- CLOSED DATE AND CLOSED BY -->

                    <div class="grid-label">Closed Date and Time</div>
                    <div class="grid-value">{{ incident.closedDateTime }}</div>

                    <div class="grid-label">Closed By</div>
                    <div class="grid-value">{{ incident.closedBy }}</div>

                    <!-- OTHER LOCATION REMARKS -->

                    <div class="grid-label full-label">
                        Other Location Remarks
                    </div>

                    <div class="grid-value full-value">
                        {{ formatNarrative(incident.otherLocationRemarks) }}
                    </div>

                    <!-- OPEN NARRATIVE -->

                    <div class="grid-label full-label">
                        Open Narrative
                    </div>

                    <div class="grid-value full-value"
                         v-html="formatNarrative(incident.openNarrative)">
                    </div>

                    <!-- CLOSED NARRATIVE -->

                    <div class="grid-label full-label">
                        Closed Narrative
                    </div>

                   <div class="grid-value full-value"
     v-html="formatNarrative(incident.closedNarrative)">
</div>

                    <!-- OPEN IMAGES -->

                    <div class="grid-label full-label">
                        Open Images
                    </div>

                    <div class="grid-value full-value">

                        <div class="incident-images">
                            <img v-for="(image, index) in incident.openImages"
                                 :key="'open-' + index"
                                 :src="image"
                                 @* crossorigin="anonymous" *@
                                 data-magnify="gallery"
                                 data-group="incident-gallery"
                                 :data-src="image"
                                 :alt="'Incident image ' + (index + 1)" />

                        </div>

                        <span v-if="incident.openImages.length === 0">
                            --
                        </span>

                    </div>

                    <!-- CLOSED IMAGES -->

                    <div class="grid-label full-label">
                        Closed Images
                    </div>

                    <div class="grid-value full-value">

                        <div class="incident-images">

                            <img v-for="(image, index) in incident.closedImages"
                                 :key="'closed-' + index"
                                 :src="image"
                                 @* crossorigin="anonymous" *@
                                 data-magnify="gallery"
                                 data-group="incident-gallery"
                                 :data-src="image"
                                 :alt="'Closed incident image ' + (index + 1)" />

                        </div>

                        <span v-if="incident.closedImages.length === 0">
                            --
                        </span>

                    </div>

                </div>

                <!-- WHO / WHAT / WHEN / WHERE / WHY -->

                <div class="incident-summary">

                    <div class="summary-item">
                        <strong>Who:</strong>
                        <p v-html="formatNarrative(incident.summary.who)"></p>
                    </div>

                    <div class="summary-item">
                        <strong>What:</strong>
                        <p v-html="formatNarrative(incident.summary.what)"></p>
                    </div>

                    <div class="summary-item">
                        <strong>When:</strong>
                        <p>{{ incident.summary.when }}</p>
                    </div>

                    <div class="summary-item">
                        <strong>Where:</strong>
                        <p>{{ incident.summary.where }}</p>
                    </div>

                    <div class="summary-item">
                        <strong>Why:</strong>
                        <p>{{ incident.summary.why }}</p>
                    </div>

                </div>

            </div>
            <!-- END INCIDENT PDF CONTENT -->

        </div>
        <!-- END INCIDENT PAGE -->

    </div>
    <!-- END VUE APPLICATION -->
    <!-- VUE 2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/vue@2.7.16/dist/vue.min.js"></script>

    <!-- AXIOS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <!-- JQUERY CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- MOMENT JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>

    <!-- HEADER COMPONENT -->
    <script src="~/js/header.js"></script>

    <!-- PDF GENERATION LIBRARY -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <!-- MAGNIFY JS -->
    
    <script src="~/lib/magnify.js/jquery.magnify.js"></script>


    <script>
    window.azureMapsKey = '@ViewBag.AzureMapsKey';
</script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- INCIDENT DETAILS JAVASCRIPT -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/Incident-Components/IncidentView.js"></script>
    
    
</body>
</html>